/target

# 会话临时脚本 / 测试沙箱（跑完即删，绝不入库）
/.scratch

# 历史探针目录（已被 probes/ 取代，留作本地参考，绝不入库）
/.asmoday-probe

# 本机测试脚本（探针套件 + 冒烟/桩站脚本）：本机调试用，不入库。
# 流程文档与脚本都由本机维护；新环境需要时照 README 的门禁清单自建。
/probes/
/scripts/

# 设计/开发笔记（设计文档、AI 契约、测试流程、早期静态原型）
# 只在本机留档，不进版本库：仓库里的契约以 README 与代码为准。
/doc/

# 前端产物（由 vite build 输出，供 rust-embed 打包）
/dist

# 运行期截图自检产物
/.shots

# 下面几项都是防御性的：运行期数据不该落在仓库里（放仓库同级的 .probe/ 或
# 服务启动目录），但万一有人从这个目录直接跑二进制，别让它们进版本库。
/data
/downloads
/config.toml
/config.toml.*

# 编辑器 / 系统杂项
.DS_Store
Thumbs.db
*.tsbuildinfo

# CI 打包镜像时从 target/ 拷到上下文根的二进制（见 .github/workflows/docker.yml）
/asmoday
