/target

# 会话临时脚本 / 测试沙箱（跑完即删，绝不入库）
/.scratch

# 历史探针目录（已被 probes/ 取代，留作本地参考，绝不入库）
/.asmoday-probe

# 探针产物（截图固定名覆盖写；脚本本身入库，见 Design/testing.md）
/probes/shots/
/probes/__pycache__/

# 前端产物（由 vite build 输出，供 rust-embed 打包）
/dist

# 运行期截图自检产物
/.shots

# 运行期数据
/data

# 运行期在仓库根目录生成的配置（属用户数据，绝不入库）
/config.toml
/config.toml.*

# 编辑器 / 系统杂项
.DS_Store
Thumbs.db
*.tsbuildinfo
